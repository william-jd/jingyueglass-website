{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/products",
      "destination": "/glassware-product-catalog",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/custom-glassware-quote-checklist",
      "permanent": true
    },
    {
      "source": "/industries",
      "destination": "/hospitality-restaurant-glassware",
      "permanent": true
    },
    {
      "source": "/oem-custom-glassware",
      "destination": "/custom-logo-glassware",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/why-do-whiskey-glasses-have-heavy-bases",
      "destination": "/why-do-whiskey-glasses-have-heavy-bases.html"
    },
    {
      "source": "/blog/can-lead-free-crystal-glasses-go-in-the-dishwasher",
      "destination": "/can-lead-free-crystal-glasses-go-in-the-dishwasher.html"
    },
    {
      "source": "/blog/borosilicate-vs-soda-lime-glass-commercial-comparison",
      "destination": "/borosilicate-vs-soda-lime-glass-commercial-comparison.html"
    },
    {
      "source": "/products/bordeaux-wine-glass-xz5202",
      "destination": "/bordeaux-wine-glass-xz5202.html"
    },
    {
      "source": "/products/smoked-cocktail-kit-torch-set",
      "destination": "/smoked-cocktail-kit-torch-set.html"
    },
    {
      "source": "/industries/distillery-spirits-glassware",
      "destination": "/distillery-spirits-glassware.html"
    },
    {
      "source": "/industries/hospitality-restaurant-glassware",
      "destination": "/hospitality-restaurant-glassware.html"
    },
    {
      "source": "/industries/corporate-luxury-gifting-glassware",
      "destination": "/corporate-luxury-gifting-glassware.html"
    },
    {
      "source": "/industries/amazon-dtc-brand-glassware-supply",
      "destination": "/amazon-dtc-brand-glassware-supply.html"
    },
    {
      "source": "/blog/laser-engraving-vs-ceramic-decals-for-glassware",
      "destination": "/laser-engraving-vs-ceramic-decals-for-glassware.html"
    },
    {
      "source": "/blog/bar-glassware-par-level-calculation-formulas",
      "destination": "/bar-glassware-par-level-calculation-formulas.html"
    },
    {
      "source": "/blog/what-certificates-required-for-us-eu-glassware-customs",
      "destination": "/what-certificates-required-for-us-eu-glassware-customs.html"
    },
    {
      "source": "/es/tazas-de-vidrio",
      "destination": "/es/tazas-de-vidrio.html"
    },
    {
      "source": "/pt/canecas-de-vidro",
      "destination": "/pt/canecas-de-vidro.html"
    }
  ]
}
