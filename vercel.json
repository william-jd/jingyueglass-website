{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/products",
      "destination": "/glassware-product-catalog",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/custom-glassware-quote-checklist",
      "permanent": true
    },
    {
      "source": "/industries",
      "destination": "/hospitality-restaurant-glassware",
      "permanent": true
    },
    {
      "source": "/oem-custom-glassware",
      "destination": "/custom-logo-glassware",
      "permanent": true
    }
  ]
}
